{
	"name": "remon-web",
	"private": true,
	"version": "0.16.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"postbuild": "bun scripts/verify-build.js && (bash scripts/deploy-caddy.sh || true)",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' && lefthook install",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "bun test",
		"test:watch": "bun test --watch"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@iconify-json/lucide": "^1.2.128",
		"@iconify-json/simple-icons": "^1.2.94",
		"@iconify/utils": "^3.1.4",
		"@inlang/paraglide-js": "^2.25.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.0",
		"@types/node": "^26.4.0",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"lefthook": "^2.1.12",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.69.0",
		"unplugin-icons": "^23.0.1",
		"vite": "^8.2.2",
		"vite-plugin-pwa": "^1.3.0",
		"workbox-precaching": "^7.4.1"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@microsoft/fetch-event-source": "^2.0.1",
		"@tanstack/svelte-query": "^6.1.48",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-web-links": "^0.12.0",
		"@xterm/xterm": "^6.0.0",
		"clsx": "^2.1.1",
		"dompurify": "^3.4.14",
		"echarts": "^6.1.0",
		"marked": "^18.0.11"
	}
}
